rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function tableAdminUid(tableId) {
      return get(/databases/$(database)/documents/tables/$(tableId)).data.adminUid;
    }

    function tableStatus(tableId) {
      return get(/databases/$(database)/documents/tables/$(tableId)).data.status;
    }

    function isParticipant(tableId) {
      return exists(
        /databases/$(database)/documents/tables/$(tableId)/participants/$(request.auth.uid)
      );
    }

    // Quem já fechou a conta, desnormalizado no doc da mesa. Existe porque rules
    // não têm laço: não dá para ler `participants/{uid}.paid` de cada uid de
    // `consumerUids`. Aqui vira um get() só + operação de conjunto.
    // O default [] mantém compatibilidade com mesas criadas antes deste campo.
    function paidUidsOf(tableId) {
      return get(
        /databases/$(database)/documents/tables/$(tableId)
      ).data.get('paidUids', []).toSet();
    }

    // Um item não pode NASCER incluindo quem já fechou a conta e foi embora:
    // ele seria cobrado à revelia. Quem paga e VOLTA sai de `paidUids`, então
    // volta a ser incluível — é assim que a reentrada destrava a participação.
    function freeOfPaid(tableId, consumerUids) {
      return !consumerUids.toSet().hasAny(paidUidsOf(tableId));
    }

    // Item liquidado: algum consumidor já pagou por ele. Congela para sempre —
    // editar ou excluir mudaria o valor de uma conta já fechada. Diferente de
    // `freeOfPaid`, não afrouxa quando o pagante volta a consumir.
    function isSettled() {
      return resource.data.get('settled', false) == true;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Coleção de usuários: cada doc é privado do dono.
    match /users/{userId} {

      // Leitura: só o próprio dono.
      allow read: if isSelf(userId);

      // Criação: autenticado, doc id == uid, campos básicos válidos.
      allow create: if isSelf(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.type in ['registered', 'anonymous']
                    && request.resource.data.coins is int
                    && request.resource.data.coins >= 0
                    && request.resource.data.currentTableId == null
                    && (!('photoURL' in request.resource.data.keys())
                        || request.resource.data.photoURL == null
                        || request.resource.data.photoURL is string);

      // Atualização: só o dono. uid/createdAt/coins são imutáveis pelo client
      // (coins só muda via Admin SDK). `type` só pode ficar igual OU subir de
      // 'anonymous' -> 'registered' (converter convidado em conta; mão única,
      // nunca o contrário). currentTableId só pode:
      //   - ficar igual,
      //   - ir de null -> id (entrar/criar mesa),
      //   - ir de id -> null (sair da mesa).
      allow update: if isSelf(userId)
                    && request.resource.data.uid == resource.data.uid
                    && (
                      request.resource.data.type == resource.data.type
                      || (
                        resource.data.type == 'anonymous'
                        && request.resource.data.type == 'registered'
                      )
                    )
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.coins == resource.data.coins
                    && (
                      request.resource.data.currentTableId == resource.data.currentTableId
                      || (
                        (!('currentTableId' in resource.data)
                          || resource.data.currentTableId == null)
                        && request.resource.data.currentTableId is string
                        && request.resource.data.currentTableId.size() > 0
                      )
                      || (
                        resource.data.currentTableId is string
                        && request.resource.data.currentTableId == null
                      )
                    )
                    && (!('photoURL' in request.resource.data.keys())
                        || request.resource.data.photoURL == null
                        || request.resource.data.photoURL is string);

      // Deleção: só o próprio dono (feature "excluir conta").
      allow delete: if isSelf(userId);
    }

    match /tables/{tableId} {

      // Qualquer pessoa autenticada (com o código) consegue ver a mesa.
      allow read: if isSignedIn();

      // Criação: só o próprio dono cria a mesa em seu nome, já aberta.
      allow create: if isSignedIn()
                    && request.resource.data.adminUid == request.auth.uid
                    && request.resource.data.status == 'aberta'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.tipPercent is number
                    && request.resource.data.tipPercent >= 0
                    && request.resource.data.couvertSuggested is number
                    && request.resource.data.couvertSuggested >= 0
                    && request.resource.data.paidUids == [];

      // Atualização: só o admin, e só a config da mesa.
      allow update: if isSignedIn()
                    && (
                      // (a) Admin edita a config da mesa. Não mexe em paidUids.
                      (
                        resource.data.adminUid == request.auth.uid
                        && request.resource.data.status in ['aberta', 'encerrada']
                        && (
                          request.resource.data.adminUid == resource.data.adminUid
                          || exists(/databases/$(database)/documents/tables/$(tableId)/participants/$(request.resource.data.adminUid))
                        )
                        && request.resource.data.get('paidUids', [])
                           == resource.data.get('paidUids', [])
                      )
                      // `paidUids` NÃO tem caminho pelo cliente: entra em
                      // `registerPayment` e sai em `reopenParticipation`, ambas
                      // Cloud Functions com Admin SDK. Deixar o cliente mexer
                      // aqui é deixá-lo se declarar pago.
                    );

      match /participants/{participantId} {

        // Leitura: o próprio, o admin da mesa, ou quem já é participante.
        allow read: if isSignedIn()
                    && (
                      request.auth.uid == participantId
                      || tableAdminUid(tableId) == request.auth.uid
                      || isParticipant(tableId)
                    );

        // Entrar: você só se adiciona a si mesmo, com estado inicial zerado,
        // e a mesa precisa estar aberta.
        allow create: if isSelf(participantId)
                      && request.resource.data.uid == participantId
                      && request.resource.data.isAnonymous is bool
                      && request.resource.data.paid == false
                      && request.resource.data.paidAt == null
                      && request.resource.data.tipEnabled is bool
                      && request.resource.data.subtotalCents == 0
                      && request.resource.data.totalCents == 0
                      && request.resource.data.settledSubtotalCents == 0
                      && request.resource.data.paidTotalCents == 0
                      && request.resource.data.settledThroughAt == null
                      && request.resource.data.couvertSettled == false
                      && tableStatus(tableId) == 'aberta';

        // Atualização pelo CLIENTE: só gorjeta e saída/volta.
        //
        // Pagamento (`paid`, `paidTotalCents`, `settledThroughAt`, ...) e
        // reabertura de rodada saem exclusivamente pelas Cloud Functions
        // `registerPayment` / `reopenParticipation`, que rodam com Admin SDK e
        // ignoram estas rules. Quem escreve `paid` escreve quanto deve — por
        // isso o cliente não tem esse caminho.
        allow update: if isSelf(participantId)
                      && tableStatus(tableId) == 'aberta'
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.displayName == resource.data.displayName
                      && request.resource.data.isAnonymous == resource.data.isAnonymous
                      && request.resource.data.joinedAt == resource.data.joinedAt
                      && request.resource.data.subtotalCents == resource.data.subtotalCents
                      && request.resource.data.totalCents == resource.data.totalCents
                      && (
                        // (1) Gorjeta opcional, antes de pagar a rodada atual.
                        (
                          resource.data.paid == false
                          && onlyChanged(['tipEnabled'])
                          && request.resource.data.tipEnabled is bool
                        )
                        // (2) Sair da mesa / voltar para ela. Permitido mesmo
                        // depois de pagar: quem já quitou pode ir embora, e o
                        // doc fica como histórico do que foi pago.
                        || (
                          onlyChanged(['left'])
                          && request.resource.data.left is bool
                        )
                      );

        // O doc do participante não é apagado ao sair (vira `left: true`, para
        // preservar o histórico financeiro). Só o admin remove de fato.
        allow delete: if isSignedIn() && tableAdminUid(tableId) == request.auth.uid;

        // Histórico de pagamentos da pessoa (uma rodada por doc). Escrito só
        // pelo Admin SDK; o cliente lê para montar o extrato.
        match /payments/{paymentId} {
          allow read: if isSignedIn()
                      && (
                        request.auth.uid == participantId
                        || tableAdminUid(tableId) == request.auth.uid
                        || isParticipant(tableId)
                      );
          allow write: if false;
        }
      }

      match /items/{itemId} {

        // Participantes da mesa e admin podem visualizar os itens
        allow read: if isSignedIn()
                    && (
                      tableAdminUid(tableId) == request.auth.uid
                      || isParticipant(tableId)
                    );

        // Participante cria um item cujo dono é ele mesmo. consumerUids é a lista
        // de quem divide o item e DEVE incluir o próprio dono: não é permitido
        // lançar um item só para outra pessoa (compartilhar inclui você).
        // Nenhum consumidor pode ter pagado — inclui o próprio autor, que é
        // obrigatoriamente um dos consumerUids (validado abaixo).
        allow create: if isSignedIn()
                      && isParticipant(tableId)
                      && freeOfPaid(tableId, request.resource.data.consumerUids)
                      && request.resource.data.get('settled', false) == false
                      && request.resource.data.ownerUid == request.auth.uid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.price is number
                      && request.resource.data.price > 0
                      && request.resource.data.consumerUids is list
                      && request.resource.data.consumerUids.size() >= 1
                      && request.auth.uid in request.resource.data.consumerUids
                      && (!('quantity' in request.resource.data)
                          || (request.resource.data.quantity is number
                              && request.resource.data.quantity >= 1))
                      && (!('icon' in request.resource.data)
                          || request.resource.data.icon == null
                          || request.resource.data.icon is string);

        // Somente o dono do item pode editar; o dono permanece na divisão.
        // Item já liquidado é intocável (`isSettled`). Além disso, não se pode
        // incluir na divisão alguém que fechou a conta e foi embora, nem agora
        // nem depois da edição — encolheria a parte de quem já pagou.
        // `settled` só muda pelo Admin SDK, por isso é imutável aqui.
        allow update: if isSignedIn()
                      && resource.data.ownerUid == request.auth.uid
                      && !isSettled()
                      && request.resource.data.get('settled', false)
                         == resource.data.get('settled', false)
                      && freeOfPaid(tableId, resource.data.get('consumerUids', []))
                      && freeOfPaid(tableId, request.resource.data.consumerUids)
                      && request.resource.data.ownerUid == resource.data.ownerUid
                      && request.resource.data.consumerUids is list
                      && request.auth.uid in request.resource.data.consumerUids
                      && (!('quantity' in request.resource.data)
                          || (request.resource.data.quantity is number
                              && request.resource.data.quantity >= 1))
                      && (!('icon' in request.resource.data)
                          || request.resource.data.icon == null
                          || request.resource.data.icon is string);

        // Somente o dono do item pode excluir — nunca um item já liquidado, e
        // nunca um que alguém ausente e quitado dividia: o subtotal dessa
        // pessoa cairia depois do fato.
        allow delete: if isSignedIn()
                      && resource.data.ownerUid == request.auth.uid
                      && !isSettled()
                      && freeOfPaid(tableId, resource.data.get('consumerUids', []));
      }
    }

    // Bloqueia qualquer outra coleção até que rules específicas sejam criadas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
