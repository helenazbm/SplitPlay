rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function tableAdminUid(tableId) {
      return get(/databases/$(database)/documents/tables/$(tableId)).data.adminUid;
    }

    function tableStatus(tableId) {
      return get(/databases/$(database)/documents/tables/$(tableId)).data.status;
    }

    function isParticipant(tableId) {
      return exists(
        /databases/$(database)/documents/tables/$(tableId)/participants/$(request.auth.uid)
      );
    }

    // Quem já fechou a conta, desnormalizado no doc da mesa. Existe porque rules
    // não têm laço: não dá para ler `participants/{uid}.paid` de cada uid de
    // `consumerUids`. Aqui vira um get() só + operação de conjunto.
    // O default [] mantém compatibilidade com mesas criadas antes deste campo.
    function paidUidsOf(tableId) {
      return get(
        /databases/$(database)/documents/tables/$(tableId)
      ).data.get('paidUids', []).toSet();
    }

    // Um item não pode NASCER incluindo quem já fechou a conta e foi embora:
    // ele seria cobrado à revelia. Quem paga e VOLTA sai de `paidUids`, então
    // volta a ser incluível — é assim que a reentrada destrava a participação.
    function freeOfPaid(tableId, consumerUids) {
      return !consumerUids.toSet().hasAny(paidUidsOf(tableId));
    }

    // Item liquidado: algum consumidor já pagou por ele. Congela para sempre —
    // editar ou excluir mudaria o valor de uma conta já fechada. Diferente de
    // `freeOfPaid`, não afrouxa quando o pagante volta a consumir.
    function isSettled() {
      return resource.data.get('settled', false) == true;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isAdminOrParticipant(tableId) {
      return tableAdminUid(tableId) == request.auth.uid || isParticipant(tableId);
    }

    // Item da comanda que veio do cardápio: nome e preço têm de ser os do
    // cardápio (preço = unitário × quantidade, a mesma conta do cliente e da
    // Cloud Function), senão bastaria apontar para o cardápio e gravar outro valor.
    function matchesMenuItem(tableId, data) {
      let menuItem = get(
        /databases/$(database)/documents/tables/$(tableId)/menuItems/$(data.menuItemId)
      ).data;
      return data.menuItemId is string
             && data.name == menuItem.name
             && data.price == menuItem.price * data.get('quantity', 1);
    }

    // Coleção de usuários: cada doc é privado do dono.
    match /users/{userId} {

      // Leitura: só o próprio dono.
      allow read: if isSelf(userId);

      // Criação: autenticado, doc id == uid, campos básicos válidos.
      allow create: if isSelf(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.type in ['registered', 'anonymous']
                    && request.resource.data.coins is int
                    && request.resource.data.coins >= 0
                    && request.resource.data.currentTableId == null
                    && (!('photoURL' in request.resource.data.keys())
                        || request.resource.data.photoURL == null
                        || request.resource.data.photoURL is string);

      // Atualização: só o dono. uid/createdAt/coins são imutáveis pelo client
      // (coins só muda via Admin SDK). `type` só pode ficar igual OU subir de
      // 'anonymous' -> 'registered' (converter convidado em conta; mão única,
      // nunca o contrário). currentTableId só pode:
      //   - ficar igual,
      //   - ir de null -> id (entrar/criar mesa),
      //   - ir de id -> null (sair da mesa).
      allow update: if isSelf(userId)
                    && request.resource.data.uid == resource.data.uid
                    && (
                      request.resource.data.type == resource.data.type
                      || (
                        resource.data.type == 'anonymous'
                        && request.resource.data.type == 'registered'
                      )
                    )
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.coins == resource.data.coins
                    && (
                      request.resource.data.currentTableId == resource.data.currentTableId
                      || (
                        (!('currentTableId' in resource.data)
                          || resource.data.currentTableId == null)
                        && request.resource.data.currentTableId is string
                        && request.resource.data.currentTableId.size() > 0
                      )
                      || (
                        resource.data.currentTableId is string
                        && request.resource.data.currentTableId == null
                      )
                    )
                    && (!('photoURL' in request.resource.data.keys())
                        || request.resource.data.photoURL == null
                        || request.resource.data.photoURL is string);

      // Deleção: só o próprio dono (feature "excluir conta").
      allow delete: if isSelf(userId);
    }

    match /tables/{tableId} {

      // Qualquer pessoa autenticada (com o código) consegue ver a mesa.
      allow read: if isSignedIn();

      // Criação: só o próprio dono cria a mesa em seu nome, já aberta.
      allow create: if isSignedIn()
                    && request.resource.data.adminUid == request.auth.uid
                    && request.resource.data.status == 'aberta'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.tipPercent is number
                    && request.resource.data.tipPercent >= 0
                    && request.resource.data.couvertSuggested is number
                    && request.resource.data.couvertSuggested >= 0
                    && request.resource.data.paidUids == [];

      // Atualização: o admin edita a config da mesa; participantes, só o nome
      // do cardápio.
      allow update: if isSignedIn()
                    && (
                      // (a) Admin edita a config da mesa. Não mexe em paidUids.
                      (
                        resource.data.adminUid == request.auth.uid
                        && request.resource.data.status in ['aberta', 'encerrada']
                        && (
                          request.resource.data.adminUid == resource.data.adminUid
                          || exists(/databases/$(database)/documents/tables/$(tableId)/participants/$(request.resource.data.adminUid))
                        )
                        && request.resource.data.get('paidUids', [])
                           == resource.data.get('paidUids', [])
                      )
                      // `paidUids` NÃO tem caminho pelo cliente: entra em
                      // `registerPayment` e sai em `reopenParticipation`, ambas
                      // Cloud Functions com Admin SDK. Deixar o cliente mexer
                      // aqui é deixá-lo se declarar pago.

                      // (b) Participante renomeia o cardápio. Só o nome: o
                      // resto da mesa continua sendo do admin.
                      || (
                        isParticipant(tableId)
                        && resource.data.status == 'aberta'
                        && onlyChanged(['menuName', 'updatedAt'])
                        && request.resource.data.menuName is string
                        && request.resource.data.menuName.size() > 0
                        && request.resource.data.menuName.size() <= 80
                      )
                    );

      match /participants/{participantId} {

        // Leitura: o próprio, o admin da mesa, ou quem já é participante.
        allow read: if isSignedIn()
                    && (
                      request.auth.uid == participantId
                      || tableAdminUid(tableId) == request.auth.uid
                      || isParticipant(tableId)
                    );

        // Entrar: você só se adiciona a si mesmo, com estado inicial zerado,
        // e a mesa precisa estar aberta.
        allow create: if isSelf(participantId)
                      && request.resource.data.uid == participantId
                      && request.resource.data.isAnonymous is bool
                      && request.resource.data.paid == false
                      && request.resource.data.paidAt == null
                      && request.resource.data.tipEnabled is bool
                      && request.resource.data.subtotalCents == 0
                      && request.resource.data.totalCents == 0
                      && request.resource.data.settledSubtotalCents == 0
                      && request.resource.data.paidTotalCents == 0
                      && request.resource.data.settledThroughAt == null
                      && request.resource.data.couvertSettled == false
                      && tableStatus(tableId) == 'aberta';

        // Atualização pelo CLIENTE: só gorjeta, saída/volta e o próprio perfil.
        //
        // Pagamento (`paid`, `paidTotalCents`, `settledThroughAt`, ...) e
        // reabertura de rodada saem exclusivamente pelas Cloud Functions
        // `registerPayment` / `reopenParticipation`, que rodam com Admin SDK e
        // ignoram estas rules. Quem escreve `paid` escreve quanto deve — por
        // isso o cliente não tem esse caminho.
        allow update: if isSelf(participantId)
                      && tableStatus(tableId) == 'aberta'
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.isAnonymous == resource.data.isAnonymous
                      && request.resource.data.joinedAt == resource.data.joinedAt
                      && request.resource.data.subtotalCents == resource.data.subtotalCents
                      && request.resource.data.totalCents == resource.data.totalCents
                      && (
                        // (1) Gorjeta opcional, antes de pagar a rodada atual.
                        (
                          resource.data.paid == false
                          && onlyChanged(['tipEnabled'])
                          && request.resource.data.tipEnabled is bool
                          && request.resource.data.displayName == resource.data.displayName
                        )
                        // (2) Sair da mesa / voltar para ela. Permitido mesmo
                        // depois de pagar: quem já quitou pode ir embora, e o
                        // doc fica como histórico do que foi pago.
                        || (
                          onlyChanged(['left'])
                          && request.resource.data.left is bool
                          && request.resource.data.displayName == resource.data.displayName
                        )
                        // (3) Nome/avatar são cópias desnormalizadas de
                        // `users/{uid}`. Ao editar o perfil, o cliente propaga a
                        // mudança para cá — senão a lista de participantes fica
                        // exibindo o nome e a foto antigos até o fim da mesa.
                        // Não mexe em dinheiro: só rótulo de quem já é você.
                        || (
                          onlyChanged(['displayName', 'avatarUrl'])
                          && request.resource.data.displayName is string
                          && request.resource.data.displayName.size() > 0
                          && (
                            request.resource.data.avatarUrl == null
                            || request.resource.data.avatarUrl is string
                          )
                        )
                      );

        // O doc do participante não é apagado ao sair (vira `left: true`, para
        // preservar o histórico financeiro). Só o admin remove de fato.
        allow delete: if isSignedIn() && tableAdminUid(tableId) == request.auth.uid;

        // Histórico de pagamentos da pessoa (uma rodada por doc). Escrito só
        // pelo Admin SDK; o cliente lê para montar o extrato.
        match /payments/{paymentId} {
          allow read: if isSignedIn()
                      && (
                        request.auth.uid == participantId
                        || tableAdminUid(tableId) == request.auth.uid
                        || isParticipant(tableId)
                      );
          allow write: if false;
        }
      }

      match /items/{itemId} {

        // Participantes da mesa e admin podem visualizar os itens
        allow read: if isSignedIn()
                    && (
                      tableAdminUid(tableId) == request.auth.uid
                      || isParticipant(tableId)
                    );

        // Participante cria um item cujo dono é ele mesmo. Só o criador entra
        // aceito (consumerUids); qualquer outro selecionado no modal entra em
        // pendingInvites e só passa a dividir o item depois de aceitar.
        //
        // Ninguém que já fechou a conta pode ser envolvido — nem como criador
        // (seria cobrado de novo), nem como convidado (o aceite diluiria a
        // parte de quem já pagou).
        allow create: if isSignedIn()
                      && isParticipant(tableId)
                      && freeOfPaid(tableId, request.resource.data.consumerUids)
                      && freeOfPaid(tableId, request.resource.data.pendingInvites)
                      && request.resource.data.get('settled', false) == false
                      && request.resource.data.ownerUid == request.auth.uid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.price is number
                      && request.resource.data.price > 0
                      && request.resource.data.consumerUids == [request.auth.uid]
                      && request.resource.data.pendingInvites is list
                      && !(request.auth.uid in request.resource.data.pendingInvites)
                      && (!('quantity' in request.resource.data)
                          || (request.resource.data.quantity is number
                              && request.resource.data.quantity >= 1))
                      && (!('icon' in request.resource.data)
                          || request.resource.data.icon == null
                          || request.resource.data.icon is string)
                      && (!('lastChange' in request.resource.data)
                          || request.resource.data.lastChange == null)
                      && (request.resource.data.get('menuItemId', null) == null
                          || matchesMenuItem(tableId, request.resource.data));

        // (1) Editar nome/valor/quantidade/ícone — qualquer consumidor aceito,
        //     vale na hora, sem aprovação de ninguém.
        //
        //     Mudar o `price` muda a conta de todo mundo que divide o item, então
        //     vale o mesmo congelamento da main: item já liquidado é intocável
        //     (`isSettled`) e nenhum item que alguém quitado divide pode ser
        //     alterado (`freeOfPaid`). `settled` fica de fora do `onlyChanged`,
        //     o que já o torna imutável pelo cliente.
        //
        //     Item que veio do cardápio não se edita aqui: nome e preço seguem o
        //     cardápio (Cloud Function `onMenuItemWrite`). `menuItemId` fica fora
        //     do `onlyChanged` de todos os ramos, então também é imutável.
        allow update: if isSignedIn()
                      && request.auth.uid in resource.data.consumerUids
                      && !isSettled()
                      && resource.data.get('menuItemId', null) == null
                      && freeOfPaid(tableId, resource.data.get('consumerUids', []))
                      && onlyChanged(['name', 'price', 'quantity', 'icon', 'updatedAt', 'lastChange'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.price is number
                      && request.resource.data.price > 0
                      && (!('quantity' in request.resource.data)
                          || (request.resource.data.quantity is number
                              && request.resource.data.quantity >= 1))
                      && (!('icon' in request.resource.data)
                          || request.resource.data.icon == null
                          || request.resource.data.icon is string)
                      && request.resource.data.lastChange.type == 'update'
                      && request.resource.data.lastChange.byUid == request.auth.uid;

        // (2) Convidar um novo participante — qualquer consumidor aceito pode
        //     propor; o alvo entra em pendingInvites, ainda não divide o item.
        //
        //     Convidar não muda valor nenhum, mas convidar quem já fechou a
        //     conta cria um convite que o aceite (3) vai recusar para sempre.
        //     Barra na origem.
        allow update: if isSignedIn()
                      && request.auth.uid in resource.data.consumerUids
                      && !isSettled()
                      && freeOfPaid(tableId, [request.resource.data.lastChange.targetUid])
                      && onlyChanged(['pendingInvites', 'updatedAt', 'lastChange'])
                      && request.resource.data.lastChange.type == 'invite'
                      && request.resource.data.lastChange.byUid == request.auth.uid
                      && request.resource.data.lastChange.targetUid is string
                      && !(request.resource.data.lastChange.targetUid in resource.data.consumerUids)
                      && !(request.resource.data.lastChange.targetUid in resource.data.pendingInvites)
                      && request.resource.data.pendingInvites
                         == resource.data.pendingInvites.concat([request.resource.data.lastChange.targetUid]);

        // (3) Responder a um convite — só o próprio convidado, sobre o
        //     próprio uid: aceitar (entra em consumerUids) ou recusar.
        //
        //     Aceitar rateia o item entre mais uma pessoa, o que ENCOLHE a parte
        //     de quem já dividia: se algum deles já pagou, a conta dele mudaria
        //     depois do fato. Por isso o ramo 'accept' exige item não liquidado
        //     e ninguém quitado na divisão. Recusar não mexe em valor e segue
        //     livre — senão um convite feito antes do pagamento ficaria preso
        //     para sempre.
        allow update: if isSignedIn()
                      && request.auth.uid in resource.data.pendingInvites
                      && onlyChanged(['consumerUids', 'pendingInvites', 'updatedAt', 'lastChange'])
                      && request.resource.data.pendingInvites
                         == resource.data.pendingInvites.removeAll([request.auth.uid])
                      && request.resource.data.lastChange.byUid == request.auth.uid
                      && (
                           (request.resource.data.lastChange.type == 'accept'
                            && !isSettled()
                            && freeOfPaid(tableId, resource.data.get('consumerUids', []))
                            && freeOfPaid(tableId, [request.auth.uid])
                            && request.resource.data.consumerUids
                               == resource.data.consumerUids.concat([request.auth.uid]))
                           || (request.resource.data.lastChange.type == 'decline'
                               && request.resource.data.consumerUids == resource.data.consumerUids)
                         );

        // (4) Autoexcluir-se — qualquer consumidor aceito, sobre o próprio
        //     uid, sem aprovação de ninguém.
        //
        //     Sair AUMENTA a parte de quem fica; item liquidado ou com alguém
        //     já quitado na divisão fica congelado.
        allow update: if isSignedIn()
                      && request.auth.uid in resource.data.consumerUids
                      && !isSettled()
                      && freeOfPaid(tableId, resource.data.get('consumerUids', []))
                      && onlyChanged(['consumerUids', 'updatedAt', 'lastChange'])
                      && request.resource.data.consumerUids
                         == resource.data.consumerUids.removeAll([request.auth.uid])
                      && request.resource.data.lastChange.type == 'leave'
                      && request.resource.data.lastChange.byUid == request.auth.uid;

        // (5) Remover outro participante (aceito ou convidado) — qualquer
        //     consumidor aceito pode remover, sem aprovação de ninguém.
        //
        //     Mesma razão de (4): remover alguém redistribui o item entre os
        //     restantes.
        allow update: if isSignedIn()
                      && request.auth.uid in resource.data.consumerUids
                      && !isSettled()
                      && freeOfPaid(tableId, resource.data.get('consumerUids', []))
                      && onlyChanged(['consumerUids', 'pendingInvites', 'updatedAt', 'lastChange'])
                      && request.resource.data.lastChange.type == 'remove'
                      && request.resource.data.lastChange.byUid == request.auth.uid
                      && request.resource.data.lastChange.targetUid != request.auth.uid
                      && (
                           resource.data.consumerUids.hasAny([request.resource.data.lastChange.targetUid])
                           || resource.data.pendingInvites.hasAny([request.resource.data.lastChange.targetUid])
                         )
                      && request.resource.data.consumerUids
                         == resource.data.consumerUids.removeAll([request.resource.data.lastChange.targetUid])
                      && request.resource.data.pendingInvites
                         == resource.data.pendingInvites.removeAll([request.resource.data.lastChange.targetUid]);

        // Sem allow delete: a exclusão do item (quando consumerUids e
        // pendingInvites ficam ambos vazios) só acontece via Cloud Function
        // (Admin SDK, ignora rules). Substitui o `allow delete` do dono que
        // existia na main — aqui o item não tem dono com privilégio, some
        // sozinho quando a última pessoa sai dele.
      }

      // Cardápio da mesa. Criação só pela Cloud Function `saveMenu` (admin,
      // depois de revisar a leitura da IA). Sem exclusão: itens da comanda
      // apontam para estes docs via `menuItemId`.
      match /menuItems/{menuItemId} {

        allow read: if isSignedIn() && isAdminOrParticipant(tableId);

        // Admin e participantes corrigem nome, seção e preço. Mudar o preço
        // propaga para a comanda (`onMenuItemWrite`), que avisa quem está no
        // item usando `updatedBy` — por isso ele precisa ser quem editou.
        allow update: if isSignedIn()
                      && isAdminOrParticipant(tableId)
                      && tableStatus(tableId) == 'aberta'
                      && onlyChanged(['name', 'section', 'price', 'updatedAt', 'updatedBy'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 80
                      && (request.resource.data.section == null
                          || (request.resource.data.section is string
                              && request.resource.data.section.size() <= 40))
                      && request.resource.data.price is number
                      && request.resource.data.price > 0
                      && request.resource.data.price <= 10000
                      && request.resource.data.updatedBy == request.auth.uid
                      && request.resource.data.updatedAt == request.time;

        allow create, delete: if false;
      }
    }

    // Bloqueia qualquer outra coleção até que rules específicas sejam criadas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
