rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function tableAdminUid(tableId) {
      return get(/databases/$(database)/documents/tables/$(tableId)).data.adminUid;
    }

    function tableStatus(tableId) {
      return get(/databases/$(database)/documents/tables/$(tableId)).data.status;
    }

    function isParticipant(tableId) {
      return exists(
        /databases/$(database)/documents/tables/$(tableId)/participants/$(request.auth.uid)
      );
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Coleção de usuários: cada doc é privado do dono.
    match /users/{userId} {

      // Leitura: só o próprio dono.
      allow read: if isSelf(userId);

      // Criação: autenticado, doc id == uid, campos básicos válidos.
      allow create: if isSelf(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.type in ['registered', 'anonymous']
                    && request.resource.data.coins is int
                    && request.resource.data.coins >= 0
                    && request.resource.data.currentTableId == null
                    && (!('photoURL' in request.resource.data.keys())
                        || request.resource.data.photoURL == null
                        || request.resource.data.photoURL is string);

      // Atualização: só o dono. uid/type/createdAt/coins são imutáveis pelo client
      // (coins só muda via Admin SDK). currentTableId só pode:
      //   - ficar igual,
      //   - ir de null -> id (entrar/criar mesa),
      //   - ir de id -> null (sair da mesa).
      allow update: if isSelf(userId)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.coins == resource.data.coins
                    && (
                      request.resource.data.currentTableId == resource.data.currentTableId
                      || (
                        (!('currentTableId' in resource.data)
                          || resource.data.currentTableId == null)
                        && request.resource.data.currentTableId is string
                        && request.resource.data.currentTableId.size() > 0
                      )
                      || (
                        resource.data.currentTableId is string
                        && request.resource.data.currentTableId == null
                      )
                    )
                    && (!('photoURL' in request.resource.data.keys())
                        || request.resource.data.photoURL == null
                        || request.resource.data.photoURL is string);

      // Deleção: só o próprio dono (feature "excluir conta").
      allow delete: if isSelf(userId);
    }

    match /tables/{tableId} {

      // Qualquer pessoa autenticada (com o código) consegue ver a mesa.
      allow read: if isSignedIn();

      // Criação: só o próprio dono cria a mesa em seu nome, já aberta.
      allow create: if isSignedIn()
                    && request.resource.data.adminUid == request.auth.uid
                    && request.resource.data.status == 'aberta'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.tipPercent is number
                    && request.resource.data.tipPercent >= 0
                    && request.resource.data.couvertSuggested is number
                    && request.resource.data.couvertSuggested >= 0;

      // Atualização: só o admin atual; status restrito. adminUid é imutável,
      // exceto na transferência de administração para outro participante da mesa.
      allow update: if isSignedIn()
                    && resource.data.adminUid == request.auth.uid
                    && request.resource.data.status in ['aberta', 'encerrada']
                    && (
                      request.resource.data.adminUid == resource.data.adminUid
                      || exists(/databases/$(database)/documents/tables/$(tableId)/participants/$(request.resource.data.adminUid))
                    );

      match /participants/{participantId} {

        // Leitura: o próprio, o admin da mesa, ou quem já é participante.
        allow read: if isSignedIn()
                    && (
                      request.auth.uid == participantId
                      || tableAdminUid(tableId) == request.auth.uid
                      || isParticipant(tableId)
                    );

        // Entrar: você só se adiciona a si mesmo, com estado inicial zerado,
        // e a mesa precisa estar aberta.
        allow create: if isSelf(participantId)
                      && request.resource.data.uid == participantId
                      && request.resource.data.isAnonymous is bool
                      && request.resource.data.paid == false
                      && request.resource.data.paidAmount == 0
                      && request.resource.data.paidAt == null
                      && request.resource.data.tipEnabled is bool
                      && request.resource.data.subtotalCents == 0
                      && request.resource.data.totalCents == 0
                      && tableStatus(tableId) == 'aberta';

        // Atualização (só o próprio, mesa aberta):
        // (1) Gorjeta opcional — apenas tipEnabled, antes de pagar.
        // (2) Registrar pagamento — paid / paidAmount / paidAt.
        // Identidade e subtotalCents/totalCents são imutáveis no client
        // (totais só mudam via Cloud Functions / Admin SDK).
        allow update: if isSelf(participantId)
                      && tableStatus(tableId) == 'aberta'
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.displayName == resource.data.displayName
                      && request.resource.data.isAnonymous == resource.data.isAnonymous
                      && request.resource.data.joinedAt == resource.data.joinedAt
                      && request.resource.data.subtotalCents == resource.data.subtotalCents
                      && request.resource.data.totalCents == resource.data.totalCents
                      && (
                        (
                          resource.data.paid == false
                          && onlyChanged(['tipEnabled'])
                          && request.resource.data.tipEnabled is bool
                          && request.resource.data.paid == false
                        )
                        || (
                          resource.data.paid == false
                          && onlyChanged(['paid', 'paidAmount', 'paidAt'])
                          && request.resource.data.paid == true
                          && request.resource.data.paidAmount is number
                          && request.resource.data.paidAmount >= 0
                          && request.resource.data.paidAt is timestamp
                          && request.resource.data.tipEnabled == resource.data.tipEnabled
                        )
                      );

        // Sair: você mesmo; ou o admin remove um participante.
        allow delete: if isSelf(participantId)
                      || (isSignedIn() && tableAdminUid(tableId) == request.auth.uid);
      }

      match /items/{itemId} {

        // Participantes da mesa e admin podem visualizar os itens
        allow read: if isSignedIn()
                    && (
                      tableAdminUid(tableId) == request.auth.uid
                      || isParticipant(tableId)
                    );

        // Participante cria um item cujo dono é ele mesmo. consumerUids é a lista
        // de quem divide o item e DEVE incluir o próprio dono: não é permitido
        // lançar um item só para outra pessoa (compartilhar inclui você).
        allow create: if isSignedIn()
                      && isParticipant(tableId)
                      && request.resource.data.ownerUid == request.auth.uid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.price is number
                      && request.resource.data.price > 0
                      && request.resource.data.consumerUids is list
                      && request.resource.data.consumerUids.size() >= 1
                      && request.auth.uid in request.resource.data.consumerUids
                      && (!('quantity' in request.resource.data)
                          || (request.resource.data.quantity is number
                              && request.resource.data.quantity >= 1))
                      && (!('icon' in request.resource.data)
                          || request.resource.data.icon == null
                          || request.resource.data.icon is string);

        // Somente o dono do item pode editar; o dono permanece na divisão.
        allow update: if isSignedIn()
                      && resource.data.ownerUid == request.auth.uid
                      && request.resource.data.ownerUid == resource.data.ownerUid
                      && request.resource.data.consumerUids is list
                      && request.auth.uid in request.resource.data.consumerUids
                      && (!('quantity' in request.resource.data)
                          || (request.resource.data.quantity is number
                              && request.resource.data.quantity >= 1))
                      && (!('icon' in request.resource.data)
                          || request.resource.data.icon == null
                          || request.resource.data.icon is string);

        // Somente o dono do item pode excluir
        allow delete: if isSignedIn()
                      && resource.data.ownerUid == request.auth.uid;
      }
    }

    // Bloqueia qualquer outra coleção até que rules específicas sejam criadas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
